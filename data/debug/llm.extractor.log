stability\":0.35,\"memoryRelevance\":0.6,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"ea4eac75-63b9-4bff-9a8e-35facfaa1736\",\"timestamp\":\"2026-04-16T00:00:00.000Z\"}}]}",
    "parsed": {
      "version": 1,
      "strategy": "llm_memory_candidates_v1",
      "event": {
        "id": "ea4eac75-63b9-4bff-9a8e-35facfaa1736",
