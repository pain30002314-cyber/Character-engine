:0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":null,\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.44,\"stability\":0.4,\"memoryRelevance\":0.4,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"a2dde51f-6dec-44c6-9ff1-12cb23043651\",\"timestamp\":\"2026-04-15T13:49:26.454+07:00\"}}]}",
    "parsed": {
      "version": 1,
