lvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.82,\"stability\":0.6,\"memoryRelevance\":0.8,\"sensitivity\":\"high\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"d5704f35-45e7-4568-ad08-dffc345efdd5\",\"timestamp\":\"2026-04-16T16:54:44.625+07:00\"}},{\"id\":\"mem_d5704f35-45e7-4568-ad08-dffc345efdd5_3\",\"kind\":\"open_loop\",\"text\":\"А тебя не задевает тот факт, что живу я с девушкой, а признаюсь в любви тебе?\",\"normalizedText\":\"тебя не задевает тот факт что живу я с девушкой а признаюсь в любви тебе\",\"summary\":null,\"confidence\":0.8,\"semantic\":{\"class\":\"relationship_signal\",\"subclass\":\"jealousy_or_discomfort_check\",\"key\":\"character_reaction_to_user_partner\",\"category\":\"relationship_boundaries_check\",\"tags\":[\"discomfort\",\"jealousy\",\"question\",\"care\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.85},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.9},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"А тебя не задевает тот факт, что живу я с девушкой, а признаюсь в любви тебе?\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":true,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":null,\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"transient\",\"salience\":0.72,\"stability\":0.25,\"memoryRelevance\":0.7,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"d5704f35-45e7-4568-ad08-dffc345ef