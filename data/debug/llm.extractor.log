":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"past\",\"anchorText\":\"посреди ночи\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.55,\"stability\":0.45,\"memoryRelevance\":0.45,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"860618a5-273b-453c-bfb2-06eeb66bde5d\",\"timestamp\":\"2026-04-19T06:47:56.726+07:00\"}},{\"id\":\"f6a7b8c9-01d2-4e3f-9a0b-1c2d3e4f5a02\",\"kind\":\"instruction\",\"text\":\"\\\"Давай просто отпустим этот осадок вместе, чтоб я расслабился\\\"\",\"normalizedText\":\"давай просто отпустим этот осадок вместе, чтоб я расслабился\",\"summary\":null,\"confidence\":0.85,\"semantic\":{\"class\":\"relationship_signal\",\"subclass\":\"shared_emotional_settlement\",\"key\":\"invite_together_to_release_residual_feeling\",\"category\":\"коммуникация_эмоции\",\"tags\":[\"давай вместе\",\"отпустим этот осадок\",\"расслабился\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":\"я\",\"confidence\":0.85},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":\"тебе (давай)\",\"confidence\":0.85},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"Давай просто отпустим этот осадок вместе, чтоб я расслабился\",\"start\":0,\"end\":0}],\"quoted\":true,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":true,\"hedged\":false},\"temporal\":{\"tense\":\"future\",\"anchorText\":\"Давай\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.8,\"stability\":0.5,\"memoryRelevance\":0.7,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"860618a5-273b-453c-bfb2-06eeb66bde5d\",\"timestamp\":\"2026-04-19T06:47:56.726+07:00\"}},{\"id\":\"0a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c55\",\"kind\":\"commitment\",\"text\":\"\\\"...мы могли завтра с тобой спокойно быть\\\"\",\"normalizedText\":\"мы могли завтра с тобой спокойно быть\",\"summary\":null,\"confidence\":0.7,\"semantic\":{\"class\":\"intent\",\"subclass\":\"tomorrow_calm_together\",\"key\":\"hope_to_be_calm_tomorrow_with_character\",\"category\":\"пожелание_на_завтра\",\"tags\":[\"завтра\",\"спокойно быть\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":\"я\",\"confidence\":0.7},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":\"с тобой\",\"confidence\":0.7},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"чтоб ... мы могли завтра с тобой спокойно быть\",\"start\":0,\"end\":0}],\"quoted\":true,\"reported\":false,\"negated\":false,\"hypothetical\":true,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":true},\"temporal\":{\"tense\":\"future\",\"anchorText\":\"завтра\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.45,\"stability\":0.35,\"memoryRelevance\":0.4,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"860618a5-273b-453c-bfb2-06eeb66bde5d\",\"timestamp\":\"2026-04-19T06:47:56.726+07:00\"}}]}",
