"tags\":[]},\"references\":{\"subject\":{\"ref\":\"unknown\",\"role\":\"unknown\",\"label\":\"мостик\",\"confidence\":0.3},\"object\":{\"ref\":\"unknown\",\"role\":\"unknown\",\"label\":\"время\",\"confidence\":0.2},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"мостик ещё время нам не синхронизирует нормально\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":null,\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.35,\"stability\":0.25,\"memoryRelevance\":0.25,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"e8992f8d-cb35-4bb7-8df9-2aae053b4b92\",\"timestamp\":\"2026-04-19T06:14:40.153+07:00\"}},{\"id\":\"cand-4\",\"kind\":\"fact\",\"text\":\"продукты то я купил, а приготовить уже сил не хватило\",\"normalizedText\":\"продукты я купил, а приготовить уже сил не хватило\",\"summary\":null,\"confidence\":0.86,\"semantic\":{\"class\":\"task_status\",\"subclass\":\"food_preparation_blocked_by_fatigue\",\"key\":\"user_bought_ingredients_but_could_not_cook_due_to_no_energy\",\"category\":\"health_or_energy_constraint\",\"tags\":[]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.9},\"object\":{\"ref\":\"unknown\",\"role\":\"entity\",\"label\":\"готовка\",\"confidence\":0.4},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"Кстати, продукты то я купил, а приготовить уже сил не хватило\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\