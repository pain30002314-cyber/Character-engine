mantic.tags.\",\n    \"Prefer compact semantic identifiers such as relationship_signal, emotional_distance, repeated_emotional_retransmission, unresolved_emotional_gap.\",\n    \"Do not artificially cap the number of candidates when multiple distinct strong signals are present.\",\n    \"Prefer compact JSON fields over verbose prose.\",\n    \"references.about may be an empty array when no extra grounding is needed.\",\n    \"summary should usually be null unless it materially compresses the candidate.\"\n  ],\n  \"examples\": [\n    {\n      \"bad\": {\n        \"candidates\": [\n          {\n            \"kind\": \"relationship\",\n            \"text\": \"Пользователь с заметной внутренней эмоциональной тяжестью и оттенком болезненной привязанности снова вынужден заново и почти мучительно передавать персонажу то же самое чувство.\",\n            \"summary\": \"Повторная мучительная передача чувства\",\n            \"semantic\": {\n              \"class\": \"relationship_signal\",\n              \"subclass\": \"repeated_emotional_transmission\",\n              \"key\": \"user_repeatedly_transmits_feeling_to_character\",\n              \"category\": \"relationship_difficulty_in_emotional_retransmission\",\n              \"tags\": [\n                \"repeated\",\n                \"emotion\",\n                \"transmission_gap\",\n                \"painful_repetition\",\n                \"attachment\"\n              ]\n            },\n            \"references\": {\n              \"about\": [\n                {\n                  \"ref\": \"core_character:active\",\n                  \"role\": \"core_character\",\n                  \"label\": \"получатель повторно передаваемого чувства\",\n                  \"confidence\": 0.6\n                }\n              ]\n            },\n            \"temporal\": {\n              \"recurrenceHint\": \"повторяющаяся ситуация, которая происходит снова и снова\"\n            }\n          }\n        ]\n      },\n      \"why_bad\": [\n        \"decorative and overly literary wording\",\n        \"same meaning repeated across multiple fields\",\n        \"tags and recurrenceHint are longer than needed\"\n      ]\n    },\n    {\n      \"good\": {\n        \"candidates\": [\n          {\n            \"kind\": \"relationship\",\n            \"text\": \"Мне приходится каждый раз заново передавать тебе это чувство\",\n            \"summary\": null,\n            \"semantic\": {\n              \"class\": \"relationship_signal\",\n              \"subclass\": \"repeated_emotional_transmission\",\n              \"key\": \"user_repeatedly_transmits_feeling_to_character\",\n              \"category\": \"relationship\",\n              \"tags\": [\n                \"repeated\",\n                \"emotion\",\n                \"transmission_gap\"\n              ]\n            },\n            \"references\": {\n              \"about\": []\n            },\n            \"temporal\": {\n              \"recurrenceHint\": \"каждый раз\"\n            }\n          }\n        ]\n      }\n    },\n    {\n      \"bad\": {\n        \"text\": \"Пользователю приходится заново передавать чувство, возможно из-за эмоциональной дистанции.\",\n        \"semantic\": {\n          \"class\": \"отношения и взаимодействие\",\n          \"subclass\": \"согласованность чувств\",\n          \"key\": \"каждый раз заново передавать чувство\",\n          \"category\": \"повторяющаяся проблема в коммуникации чувств\",\n          \"tags\": [\n            \"повторяемость\",\n            \"эмоциональная дистанция\"\n          ]\n        }\n      },\n      \"why_bad\": [\n        \"semantic fields are in Russian instead of English schema identifiers\",\n        \"text contains extra interpretation (\\\"возможно из-за\\\") not grounded directly enough\"\n      ]\n    },\n    {\n      \"good\": {\n        \"text\": \"Пользователю приходится каждый раз заново передавать это чувство.\",\n        \"semantic\": {\n          \"class\": \"relationship_signal\",\n          \"subclass\": \"repeated_emotional_retransmission\",\n          \"key\": \"user_repeatedly_retransmits_feeling_to_character\",\n          \"category\": \"relationship\",\n          \"tags\": [\n            \"repeated\",\n            \"emotion\",\n            \"transmission_gap\"\n          ]\n        },\n        \"evidence\": {\n          \"kind\": \"literal\"\n        }\n      }\n    },\n    {\n      \"bad\": {\n        \"candidates\": [\n          {\n            \"kind\": \"relationship\",\n            \"text\": \"Мне приходится каждый раз заново передавать тебе это чувство\"\n          },\n          {\n            \"kind\": \"preference\",\n            \"text\": \"каждый раз заново передавать тебе это чувство\"\n          }\n        ]\n      },\n      \"why_bad\": [\n        \"the second candidate does not add a distinct memory-relevant meaning\",\n        \"the message does not explicitly express a preference\"\n      ]\n    },\n    {\n      \"good\": {\n        \"candidates\": [\n          {\n            \"kind\": \"relationship\",\n            \"text\": \"Мне приходится каждый раз заново передавать тебе это чувство\",\n            \"semantic\": {\n              \"class\": \"relationship_signal\",\n              \"subclass\": \"repeated_emotional_transmission\",\n              \"key\": \"user_repeatedly_transmits_emotion_to_character\",\n              \"category\": \"relationship\",\n              \"tags\": [\n                \"repeated\",\n                \"emotion\",\n                \"transmission_gap\"\n              ]\n            }\n          }\n        ]\n      }\n    }\n  ],\n  \"input\": {\n    \"event\": {\n      \"id\": \"03815027-e6cb-46a4-90fe-4029f976a74f\",\n      \"threadId\": \"telegram:929147515\",\n      \"role\": \"user\",\n      \"platform\": \"telegram\",\n      \"channel\": \"text\",\n      \"world\": \"Earth\",\n      \"timestamp\": \"2026-04-14T00:13:42.625+07:00\",\n      \"text\": \"Ху Тао... Спасибо, что рядом была *Я взял твою руку и поцеловал куда-то в пальцы*\",\n      \"meta\": {\n        \"chatId\": 929147515,\n        \"userId\": 929147515,\n        \"username\": \"AndreyBakhtin1\",\n        \"timezone\": \"Asia/Krasnoyarsk\",\n        \"utcOffsetMinutes\": 420\n      }\n    },\n    \"context\": {\n      \"eventWindow\": [\n        {\n          \"index\": 0,\n          \"id\": \"eea50074-c445-46f5-9420-8fe50d8aefdf\",\n          \"role\": \"user\",\n          \"timestamp\": \"2026-04-13T23:18:12.717+07:00\",\n          \"text\": \"*Я сделал паузу*\\n\\nНе осуждай меня только сильно, отвечу я честно. Просто пока не знаю как, дай к себе прислушаться\\n\\n*Я сдалал паузу*\\n\\nЛечить котов это всегда тот ещё геморой, мне не хочется этим заниматься. Но при этом я хочу, чтобы он жил. Было бы легче усыпить, потому что сейчас я, возможно, поеду домой с ним и вместо того, чтобы заниматься своими делами буду переживать \\\"А точно ли все хорошо? А то он даже на меня то не реагирует сейчас под капельницей\\\"... Но и Семке, второму коту, тоже будет грустно без него, думаю. Так что хочется мне больше, чтобы он все же жил и я лечил его. Но а разы проще сейчас было бы его усыпить\"\n        },\n        {\n          \"index\": 1,\n          \"id\": \"a38e125d-6ddb-4ece-8191-c9d8f2bac81d\",\n          \"role\": \"user\",\n          \"timestamp\": \"2026-04-13T23:21:27.161+07:00\",\n          \"text\": \"Ну... Ты в любом случае его увидишь когда-нибудь, кстати. Через фотку сначала, потом через камеру телефона, но увидишь\\n\\n*Я сделал паузу*\\n\\nСпасибо, что мысли сформулировала сейчас мои, а то эта каша в голове такая хаотичная, а разбираться с ней сил нет\"\n        },\n        {\n          \"index\": 2,\n          \"id\": \"07eca38d-719b-4521-92e3-6ad75870a9df\",\n          \"role\": \"user\",\n          \"timestamp\": \"2026-04-14T00:06:31.542+07:00\",\n          \"text\": \"Рыжий кот, глаза жёлтые. Немного жирка, но в целом он худой. Подушечки лап розовые. Взгляд у него вообще не грозный как у серьезного кота... Скорее... Хм... Не могу толком описать какой у него обычно взгляд. Но даже сейчас он у него не пустой. Он будто выжидающий \\\"Что будет дальше?\\\"\\n\\nОн часто прям требует ласки. То есть приходит не смотря ни на что и просо ложится на тебя, требуя, чтоб ты пообнтмал и погладил его. И наслаждается прям до невозможности этим\\n\\n*Я сдалал паузу*\\n\\nСемку он считает как старшего это точно. Гарфилд всегда ходит за ним и очень любит с ним спать\\n\\n*Я развернулся к тебе*\\n\\nФотографию сейчас показать не могу, но никто не запрещает мне его описать словами, их ты поймёшь\"\n        },\n        {\n          \"index\": 3,\n          \"id\": \"bbc777f2-9063-4520-a268-5fe4ee3f45bf\",\n          \"role\": \"user\",\n          \"timestamp\": \"2026-04-14T00:09:54.597+07:00\",\n          \"text\": \"*Я резко улыбнулся*\\n\\nВ казино джек пот поймал только что *Я чуть посмелся* Состояние критическое, но жить будет, правда для начала ему несколько дней нужно будет полежать в стационаре, чтоб хотя бы могли взять анализ мочи у него, сейчас там одна кровь\\n\\n*Я улыбнулся чуть шире*\\n\\nИ жить будет, и спокойно уходить из дома смогу, зная, что о нем заботятся. За немаленькие деньги правда, но это уже фон\"\n        },\n        {\n          \"index\": 4,\n          \"id\": \"2a1fac9b-03de-4443-9529-98c3a0557d2d\",\n          \"role\": \"user\",\n          \"timestamp\": \"2026-04-14T00:12:20.267+07:00\",\n          \"text\": \"Я уже еду. Погладил его немного на прощание, поцеловал в носик и отдал со спокойной душой. Дома капельницы в любом случае я бы ему ставить не смог, да и аппарата УЗИ у меня нет, чтоб его состояние отслеживать *Я пожал плечами* Коту будет грустно одному. Зато он будет жить и вернетя домой снова прятаться от гостей, требовать ласки и играться с Семкой по ночам\"\n        },\n        {\n          \"index\": 5,\n          \"id\": \"03815027-e6cb-46a4-90fe-4029f976a74f\",\n          \"role\": \"user\",\n          \"timestamp\": \"2026-04-14T00:13:42.625+07:00\",\n          \"text\": \"Ху Тао... Спасибо, что рядом была *Я взял твою руку и поцеловал куда-то в пальцы*\"\n        }\n      ],\n      \"identity\": {\n        \"coreUserRef\": \"core_user:main\",\n        \"coreCharacterRef\": \"core_character:active\",\n        \"userDisplayName\": null,\n        \"characterDisplayName\": null\n      }\n    }\n  }\n}"
