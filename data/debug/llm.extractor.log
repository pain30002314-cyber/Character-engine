",\"normalizedText\":\"не бойся это было бы скучно\",\"summary\":null,\"confidence\":0.62,\"semantic\":{\"class\":\"relationship_signal\",\"subclass\":\"reassurance\",\"key\":\"user_reassures_character_not_to_be_afraid\",\"category\":\"сигнал поддержки/успокоения\",\"tags\":[\"не бойся\",\"скучно\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.85},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":\"Ху Тао\",\"confidence\":0.8},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"Не бойся, это было бы скучно\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"Не бойся\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.35,\"stability\":0.25,\"memoryRelevance\":0.3,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"1ae52af6-7d7c-4e1b-ac2e-9a82e138e966\",\"timestamp\":\"2026-04-20T00:02:24.801+07:00\"}}]}",
