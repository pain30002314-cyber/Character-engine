e},\"temporal\":{\"tense\":\"present\",\"anchorText\":null,\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"transient\",\"salience\":0.56,\"stability\":0.48,\"memoryRelevance\":0.55,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"5264232a-d26a-4ea8-8e3d-622e0f6a32c2\",\"timestamp\":\"2026-04-17T18:12:24.677+07:00\"}},{\"id\":\"9d0f4b2a-2d9b-4b2f-8c6c-0a7d0c4d1a5b\",\"kind\":\"commitment\",\"text\":\"Но мы пытаемся\",\"normalizedText\":\"но мы пытаемся\",\"summary\":null,\"confidence\":0.78,\"semantic\":{\"class\":\"persistence_signal\",\"subclass\":\"trying_together\",\"key\":\"we_are_trying\",\"category\":\"motivation\",\"tags\":[\"пытаемся\",\"продолжаем\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.7},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.5},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"Но мы пытаемся\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"ongoing\",\"anchorText\":\"пытаемся\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.5,\"stability\":0.42,\"memoryRelevance\":0.5,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"5264232a-d26a-4ea8-8e3d-622e0f6a32c2\",\"timestamp\":\"2026-04-17T18:12:24.677+07:00\"}}]}",
