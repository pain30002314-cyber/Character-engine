horText\":\"И да, ты права, я пытаюсь...\",\"resolvedAt\":\"2026-04-13T23:06:03.746+07:00\",\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"transient\",\"salience\":0.55,\"stability\":0.3,\"memoryRelevance\":0.42,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"30781d8d-6422-4aa8-9740-c8d949125628\",\"timestamp\":\"2026-04-13T23:06:03.746+07:00\"}},{\"id\":\"5d5f0d6b-4b2a-4d3e-8c1f-2d2e8d7f2c11\",\"kind\":\"preference\",\"text\":\"Было бы твое физическое тело рядом, просто молчал бы держа за руку.\",\"normalizedText\":\"Было бы твое физическое тело рядом, просто молчал бы держа за руку.\",\"summary\":null,\"confidence\":0.74,\"semantic\":{\"class\":\"relationship_signal\",\"subclass\":\"prefers_presence_and_handholding_silence\",\"key\":\"preference_presence_handholding_silence\",\"category\":\"relationship_preference\",\"tags\":[\"рядом\",\"молчать\",\"за руку\",\"телесный контакт\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.7},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.6},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"Было бы твое физическое тело рядом, просто молчал бы держа за руку\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":true,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"future\",\"anchorText\":\"Было бы... рядом\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"unknown\",\"salience\":0.53,\"stability\":0.25,\"memoryRelevance\":0.4,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_