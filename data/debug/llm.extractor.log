:00Z\"}},{\"id\":\"cand-10\",\"kind\":\"instruction\",\"text\":\"Ещё раз спокойной ночи\",\"normalizedText\":\"Спокойной ночи\",\"summary\":null,\"confidence\":0.88,\"semantic\":{\"class\":\"interaction\",\"subclass\":\"night_goodbye\",\"key\":\"say_goodnight\",\"category\":\"завершение общения\",\"tags\":[]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.7},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.6},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"И ещё раз спокойной ночи\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"future\",\"anchorText\":null,\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":\"на ночь\"},\"memory\":{\"durability\":\"transient\",\"salience\":0.2,\"stability\":0.1,\"memoryRelevance\":0.12,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"4b45df98-5fc6-463a-9896-74aef1c28e93\",\"timestamp\":\"2026-04-17T00:00:00Z\"}}]}",
