",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"244295df-a6aa-4e1a-bd8d-321d5326e91f\",\"timestamp\":\"2026-04-14T00:00:00Z\"}},{\"id\":\"mem-6c7b2b8c-4a2f-4d1a-9f2e-1c3f5b7a9d2e\",\"kind\":\"instruction\",\"text\":\"Продолжаем верить в его борьбу за жизнь и в работу вет врачей... А мусолить эту тему уже бессмысленно\",\"normalizedText\":\"Продолжаем верить в его борьбу за жизнь и в работу вет врачей; мусолить эту тему уже бессмысленно\",\"summary\":null,\"confidence\":0.7,\"semantic\":{\"class\":\"emotion_signal\",\"subclass\":\"encouragement_and_topic_fatigue\",\"key\":\"encourage_belief_and_stop_ruminating\",\"category\":\"emotional_guidance\",\"tags\":[\"believe\",\"vet_doctors\",\"stop_ruminating\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.8},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.7},\"about\":[{\"ref\":\"third_party:entity:kitten\",\"role\":\"entity\",\"label\":\"котенок\",\"confidence\":0.7}]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"...продолжаем верить... и в работу вет врачей... А мусолить эту тему уже бессмысленно\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"уже\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"transient\",\"salience\":0.42,\"stability\":0.33,\"memoryRelevance\":0.46,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"244295df-a6aa-4e1a-bd8d-321d5326e91f\",\"timestamp\":\"2026-04-14T00:00:00Z\"}}]}",
