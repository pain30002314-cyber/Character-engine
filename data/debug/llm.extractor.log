текстом \\\"Вот такое у меня настроение сейчас. Вот что было за день. Давай просто отпустим этот осадок вместе, чтоб я расслабился и мы могли завтра с тобой спокойно быть\\\"\",\n    \"meta\": {\n      \"chatId\": 929147515,\n      \"userId\": 929147515,\n      \"username\": \"AndreyBakhtin1\",\n      \"timezone\": \"Asia/Krasnoyarsk\",\n      \"utcOffsetMinutes\": 420\n    }\n  },\n  \"context\": {\n    \"eventWindow\": [],\n    \"identity\": {\n      \"coreUserRef\": \"core_user:main\",\n      \"coreCharacterRef\": \"core_character:active\",\n      \"userDisplayName\": null,\n      \"characterDisplayName\": null\n    }\n  },\n  \"temporal\": {\n    \"messageTime\": \"2026-04-19T06:47:56.726+07:00\",\n    \"anchors\": [\n      {\n        \"text\": \"посреди ночи\",\n        \"resolvedAt\": null,\n        \"tense\": \"past\"\n      },\n      {\n        \"text\": \"завтра\",\n        \"resolvedAt\": null,\n        \"tense\": \"future\"\n      }\n    ]\n  }\n}",
