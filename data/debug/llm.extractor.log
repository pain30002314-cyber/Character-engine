\"stability\":0.52,\"memoryRelevance\":0.6,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"e9b163f1-7879-49a5-be3d-a193436356b3\",\"timestamp\":\"2026-04-17T01:11:40.898+07:00\"}}]}",
