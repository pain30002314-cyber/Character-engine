l,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"episodic\",\"salience\":0.35,\"stability\":0.25,\"memoryRelevance\":0.3,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"173e97c8-748d-4386-9f27-85b2a5efdba1\",\"timestamp\":\"2026-04-19T15:45:40.231+07:00\"}},{\"id\":\"cnd_6\",\"kind\":\"relationship\",\"text\":\"С кем-нибудь другим я и не думал бы о таком\",\"normalizedText\":\"с кем-нибудь другим я и не думал бы о таком\",\"summary\":null,\"confidence\":0.7,\"semantic\":{\"class\":\"relationship_signal\",\"subclass\":\"uniqueness_of_bond\",\"key\":\"would_not_do_with_others\",\"category\":\"исключительность отношений\",\"tags\":[\"не с кем-нибудь другим\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.8},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.8},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"С кем-нибудь другим я и не думал бы о таком\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":null,\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.4,\"stability\":0.4,\"memoryRelevance\":0.45,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"173e97c8-748d-4386-9f27-85b2a5efdba1\",\"timestamp\":\"2026-04-19T15:45:40.231+07:00\"}},{\"id\":\"cnd_7\",\"kind\":\"goal\",\"text\":\"А с тобой мне хочется разделить все моменты до и после него\",\"normalizedText\":\"а с тобой мне хоч