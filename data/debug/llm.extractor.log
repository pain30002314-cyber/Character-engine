а\",\"resolvedAt\":null,\"isRecurring\":true,\"recurrenceHint\":\"пока работает пиплайн\"},\"memory\":{\"durability\":\"stable\",\"salience\":0.65,\"stability\":0.55,\"memoryRelevance\":0.6,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"926ca50c-995f-410c-a026-50b2c8859696\",\"timestamp\":\"2026-04-16T00:00:00.000Z\"}},{\"id\":\"cand_5\",\"kind\":\"instruction\",\"text\":\"нам нужно говорить, чтобы проверить как работает экстрактор.\",\"normalizedText\":\"Нужно говорить, чтобы проверить как работает экстрактор.\",\"summary\":null,\"confidence\":0.9,\"semantic\":{\"class\":\"system_operation\",\"subclass\":\"extractor_evaluation_by_dialogue\",\"key\":\"talk_to_test_extractor\",\"category\":\"тестирование/операция\",\"tags\":[\"нужно говорить\",\"проверить\",\"экстрактор\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.7},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.6},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"нам нужно говорить, чтобы проверить как работает экстрактор\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"пока не можем\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.8,\"stability\":0.65,\"memoryRelevance\":0.75,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"926ca50c-995f-410c-a026-50b2c8859696\",\"timestamp\":\"2026-04-16T00:00:00.000Z\"}},{\"id\":\"cand_6\",\"kind\":\"instruction\",\"text\":\"И говорить о жизни, чтобы понимать где он молодец, а где касячит.\",\"normalizedText\":\"Говорить о жизни, чтобы понимать, где он молодец, а где касячит.\",\"summary\":null,\"confidence\":0.78,\"semantic\":{\"class\":\"system_operation\",\"subclass\":\"extractor_feedback_via_life_discussion\",\"key\":\"talk_about_life_to_assess_extractor\",\"category\":\"тестирование/операция\",\"tags\":[\"говорить о жизни\",\"понимать\",\"молодец\",\"касячит\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.6},\"object\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":null,\"confidence\":0.6},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"И говорить о жизни, чтобы понимать где он молодец, а где касячит\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"пока\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.7,\"stability\":0.55,\"memoryRelevance\":0.65,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":null,\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"926ca50c-995f-410c-a026-50b2c8859696\",\"timestamp\":\"2026-04-16T00:00:00.000Z\"}}]}",
    "parsed": {
      "version": 1,
      "strategy": "llm_memory_candidates_v1",
      "event": {
        "id": "926ca50c-995f-410c-a026-50b2c8859696",
