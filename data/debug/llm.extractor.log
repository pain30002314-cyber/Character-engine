ility\":0.3,\"memoryRelevance\":0.5,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"llm_memory_candidates_v1\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"e63c4337-30db-4a39-b867-3a5688616528\",\"timestamp\":\"2026-04-14T01:05:45.796+07:00\"}},{\"id\":\"mem_20260413_010545_3\",\"kind\":\"fact\",\"text\":\"Я ж с России, к нам нельзя завозить всякие злые фанты и колы, зато продавать под другим названием можно.\",\"normalizedText\":\"с россии: нельзя завозить фанту и колу, можно продавать под другим названием\",\"summary\":null,\"confidence\":0.66,\"semantic\":{\"class\":\"fact\",\"subclass\":\"regional_import_constraint\",\"key\":\"user_says_no_import_fanta_cola_names_in_russia\",\"category\":\"информация о доступности товаров\",\"tags\":[\"Россия\",\"доступность\",\"бренд\"]},\"references\":{\"subject\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":null,\"confidence\":0.65},\"object\":{\"ref\":null,\"role\":\"third_party\",\"label\":\"завоз фанты и колы\",\"confidence\":0.4},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"я ж с России, к нам нельзя завозить... зато продавать под другим названием можно\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":true,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"я ж с России\",\"resolvedAt\":null,\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.28,\"stability\":0.45,\"memoryRelevance\":0.26,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"llm_memory_candidates_v1\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"e63c4337-30db-4a39-b867-3a5688616528\",\"timestamp\":\"2026-04-14T01:05:45.796+07:00\"}}]}",
