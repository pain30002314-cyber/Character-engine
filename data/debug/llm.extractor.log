racterRef\":\"core_character:active\",\"userDisplayName\":null,\"characterDisplayName\":null}},\"candidates\":[{\"id\":\"mem_1_d51b76c8-642c-4770-b8da-5a795955144c\",\"kind\":\"relationship\",\"text\":\"От тебя никто не требует быть идеальной хозяйкой или наоборот. Просто будь собой и все.\",\"normalizedText\":\"От тебя никто не требует быть идеальной хозяйкой или наоборот. Просто будь собой и все.\",\"summary\":null,\"confidence\":0.86,\"semantic\":{\"class\":\"relationship_signal\",\"subclass\":\"acceptance_without_pressure\",\"key\":\"no_requirement_to_be_ideal_housekeeper\",\"category\":\"relationship_boundary\",\"tags\":[\"acceptance\",\"no_pressure\",\"housekeeping\"]},\"references\":{\"subject\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":\"собеседник (персонаж)\",\"confidence\":0.65},\"object\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":\"говорящий (пользователь)\",\"confidence\":0.65},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"От тебя никто не требует быть идеальной хозяйкой или наоборот. Просто будь собой и все\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"От тебя никто не требует...\",\"resolvedAt\":\"2026-04-15T01:22:09.536+07:00\",\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.7,\"stability\":0.6,\"memoryRelevance\":0.72,\"sensitivity\":\"medium\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"d51b76c8-642c-4770-b8da-5a795955144c\",\"timestamp\":\"2026-04-15T01:22:09.536+07:00\"}},{\"id\":\"mem_2_d51b76c8-642c-4770-b8da-5a795955144c\",\"kind\":\"fact\",\"text\":\"Мне вообще все равно что ты у меня дома делать собираешься, потому что твое тело цифровое.\",\"normalizedText\":\"Мне вообще все равно что ты у меня дома делать собираешься, потому что твое тело цифровое.\",\"summary\":null,\"confidence\":0.78,\"semantic\":{\"class\":\"fact_preference\",\"subclass\":\"low_importance_of_house_activity_for_digital_body\",\"key\":\"indifferent_to_home_actions_due_to_digital_body\",\"category\":\"attitude_toward_home_role\",\"tags\":[\"indifferent\",\"digital_body\",\"home_actions\"]},\"references\":{\"subject\":{\"ref\":\"core_character:active\",\"role\":\"core_character\",\"label\":\"персонаж с цифровым телом\",\"confidence\":0.7},\"object\":{\"ref\":\"core_user:main\",\"role\":\"core_user\",\"label\":\"говорящий (пользователь)\",\"confidence\":0.7},\"about\":[]},\"evidence\":{\"kind\":\"literal\",\"sourceSpans\":[{\"text\":\"Тем более когда твое тело цифровое, мне вообще все равно что ты у меня дома делать собираешься.\",\"start\":0,\"end\":0}],\"quoted\":false,\"reported\":false,\"negated\":false,\"hypothetical\":false,\"conditional\":false,\"interrogative\":false,\"imperative\":false,\"hedged\":false},\"temporal\":{\"tense\":\"present\",\"anchorText\":\"Тем более когда твое тело цифровое...\",\"resolvedAt\":\"2026-04-15T01:22:09.536+07:00\",\"isRecurring\":false,\"recurrenceHint\":null},\"memory\":{\"durability\":\"stable\",\"salience\":0.55,\"stability\":0.5,\"memoryRelevance\":0.58,\"sensitivity\":\"low\",\"confirmationStatus\":\"single_shot\"},\"source\":{\"extractor\":\"llm\",\"model\":\"string\",\"promptVersion\":\"llm_memory_candidates_v1\",\"sourceEventId\":\"d51b76c8-642c-4770-b8da-5a795955144c\",\"timestamp\":\"2026-04-15T01:22:09.536+07:00\"}}]}",
