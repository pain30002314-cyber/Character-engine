  "clauses": [
    {
      "clauseId": "clause_1",
      "text": "Я тихонько посмеялся",
      "normalizedText": "я тихонько посмеялся",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_2",
      "text": "Сказал я с лёгкой улыбкой",
      "normalizedText": "сказал я с лёгкой улыбкой",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": true,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_3",
      "text": "Я задумался",
      "normalizedText": "я задумался",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_4",
      "text": "Да я б слюной подавился или от голода умер бы, если б тебе рассказывать о них начал Так, ладно, реально выбор у нас из двух сейчас.",
      "normalizedText": "да я б слюной подавился или от голода умер бы, если б тебе рассказывать о них начал так, ладно, реально выбор у нас из двух сейчас.",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": true,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_5",
      "text": "В одном очень хорошо готовят пиццу, додо пицца,",
      "normalizedText": "в одном очень хорошо готовят пиццу, додо пицца,",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_6",
      "text": "но в меню больше взять толком нечего.",
      "normalizedText": "но в меню больше взять толком нечего.",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_7",
      "text": "В другом достаточно вкусно готовят пиццу, бесплатно кладут колбасный бортик, так ещё и много всего разного можно заказать на уровне \" просто покушать норм\".",
      "normalizedText": "в другом достаточно вкусно готовят пиццу, бесплатно кладут колбасный бортик, так ещё и много всего разного можно заказать на уровне \" просто покушать норм\".",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": true
      }
    },
    {
      "clauseId": "clause_8",
      "text": "Том Ям у них, конечно, не ресторанный,",
      "normalizedText": "том ям у них, конечно, не ресторанный,",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_9",
      "text": "но я съел всю тарелку до конца один раз,",
      "normalizedText": "но я съел всю тарелку до конца один раз,",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_10",
      "text": "а значит приготовлен не из мочи Блин, хочу я только пиццу или ещё что-то дополнительно. ..",
      "normalizedText": "а значит приготовлен не из мочи блин, хочу я только пиццу или ещё что-то дополнительно. ..",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_11",
      "text": "Супчик. ..",
      "normalizedText": "супчик. ..",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
        "isReported": false,
        "isHedged": false,
        "hasQuote": false
      }
    },
    {
      "clauseId": "clause_12",
      "text": "Салатик. ..",
      "normalizedText": "салатик. ..",
      "flags": {
        "isQuestion": false,
        "isImperative": false,
        "isConditional": false,
        "isHypothetical": false,
